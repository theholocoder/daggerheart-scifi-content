{{!--
    One titled, droppable section of document rows - the fieldset/legend/create-button/list wrapper
    around `dhscifi.inventory-item`. Mirrors `daggerheart`'s own
    templates/sheets/global/partials/inventory-fieldset-items-V2.hbs split (see that partial's
    doc comment); registered as `dhscifi.inventory-items` in `src/main.ts`.

    Module-wide, not Spaceship-specific: the Spaceship sheet's Inventory/Features/Stations/Effects
    tabs and the System item sheet's Actions/Effects tabs (#15) all render through this same pair,
    exactly as daggerheart's own character, npc, adversary, environment and party sheets share
    *its* pair. That is why the file sits in `templates/partials/` rather than under
    `templates/actors/spaceship/`.

    `fieldset.glassy`/`legend`/`drop-section`/`items-list` are daggerheart classes reused by
    value - themed unscoped under `.application.daggerheart.dh-style`, per docs/adr/0002.

    `@root.editable` (core `DocumentSheetV2`'s own render-context flag: can this user actually edit
    this document?) gates the create button here and the mutating row controls in
    `dhscifi.inventory-item` - the character sheet gates the same things on the same flag
    (`canCreate=@root.editable`/`showActions=@root.editable` in its own `features.hbs`, `{{#if
    @root.editable}}` around the equip toggles in `inventory-item-V2.hbs`), so an observer/limited
    user sees a read-only list rather than create/delete affordances that would fail server-side.

    Parameters:
    - title {string} : localization key for the legend.
    - createType {string} : Item type the legend's "+" creates (`data-item-type` on the
      `createItem` action). Omitted = no create button. Item lists only - an effects list has no
      type to choose (`createEffect` always creates a `base` ActiveEffect, exactly as
      daggerheart's own legend collapses `data-type` to `'base'` for `type='effect'`), so its "+"
      is driven by `isEffect` instead, and an actions list picks its type in daggerheart's own
      follow-up dialog, so that one is driven by `isAction`.
    - isAction {boolean} : this list holds daggerheart Action documents (#15) - gives the legend a
      `createAction` "+" and is passed through to `dhscifi.inventory-item`.
    - isEffect {boolean} : this list holds ActiveEffects, not Items (#9) - gives the legend a
      `createEffect` "+" and is passed through to `dhscifi.inventory-item`, which mirrors the
      `type='effect'` branches of daggerheart's own row partial.
    - createDisabled {boolean} : effects lists only - the legend's "+" creates the new effect
      already disabled, so creating from the *inactive* section lands it in that section. Same
      `disabled` parameter, same purpose, as daggerheart's own fieldset partial.
    - collection {ItemRowEntry[]} : rows to render (`{item, tags, hasDescription, usable, canChat,
      disabled}`, built in spaceship-actor-sheet.ts).
    - isGlassy {boolean} : apply daggerheart's `glassy` fieldset treatment. Matches the character
      sheet's own split - its Inventory tab passes it, its Features tab doesn't.
    - equipIcon {string} : passed through to `dhscifi.inventory-item`.
    - quantifiable {boolean} : passed through to `dhscifi.inventory-item`.
    - mounts {{value, max}} : optional weapon-mount usage shown next to the legend (weapons only).
    - hideContextMenu {boolean} : passed through to `dhscifi.inventory-item` - swaps the row's kebab
      menu for standalone edit/delete anchors. daggerheart's own parameter, spelled the same way and
      used for the same reason its npc/adversary/environment/party sheets pass it.
--}}
<fieldset class="{{#if isGlassy}}glassy {{/if}}drop-section">
    <legend>
        {{localize title}}
        {{!-- Nested plain `{{#if}}`s rather than an `(and ...)` subexpression: this module
              registers only its own Handlebars helpers (ADR 0002) and doesn't depend on
              daggerheart's `and`/`or`/`eq` set being present. --}}
        {{#if @root.editable}}
            {{#if isEffect}}
                <a data-action="createEffect" data-disabled="{{#if createDisabled}}true{{else}}false{{/if}}" data-tooltip="{{localize 'DHSCIFI.Rows.CreateEffect'}}">
                    <i class="fa-solid fa-plus"></i>
                </a>
            {{else}}
                {{#if isAction}}
                    <a data-action="createAction" data-tooltip="{{localize 'DHSCIFI.Rows.CreateAction'}}">
                        <i class="fa-solid fa-plus"></i>
                    </a>
                {{else}}
                    {{#if createType}}
                        <a data-action="createItem" data-item-type="{{createType}}" data-tooltip="{{localize 'DHSCIFI.Rows.CreateItem'}}">
                            <i class="fa-solid fa-plus"></i>
                        </a>
                    {{/if}}
                {{/if}}
            {{/if}}
        {{/if}}
        {{#if mounts}}
            <span class="mounts-count" data-tooltip="{{localize 'DHSCIFI.Spaceship.WeaponMounts'}}">
                ({{mounts.value}} / {{mounts.max}})
            </span>
        {{/if}}
    </legend>
    <ul class="items-list">
        {{#each collection as |entry|}}
            {{> "dhscifi.inventory-item"
                item=entry.item
                tags=entry.tags
                hasDescription=entry.hasDescription
                usable=entry.usable
                canChat=entry.canChat
                disabled=entry.disabled
                isEffect=../isEffect
                isAction=../isAction
                equipIcon=../equipIcon
                quantifiable=../quantifiable
                hideContextMenu=../hideContextMenu
            }}
        {{/each}}
    </ul>
</fieldset>
