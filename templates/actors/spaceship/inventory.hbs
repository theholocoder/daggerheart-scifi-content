{{!--
    Inventory tab (#6): weapons/armor/consumables/loot lists reusing daggerheart's existing item
    types. The row/fieldset markup lives in `partials/inventory-item.hbs` and
    `partials/inventory-fieldset-items.hbs` (see those files for the copied-by-value class names
    and behavior notes) - the same partial split daggerheart itself uses, and shared with the
    Features tab (#7) exactly as the character sheet shares its own between the two.

    No currency/gold section (System Points, #6's sibling ticket, replaces it on a ship).
--}}
<section class="tab {{tab.id}} {{tab.cssClass}} spaceship-inventory" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="items-section">
        {{> "dhscifi.inventory-items"
            title="TYPES.Item.weapon"
            createType="weapon"
            isGlassy=true
            collection=inventory.weapons
            equipIcon="fa-hands"
            mounts=inventory.mounts
        }}

        {{> "dhscifi.inventory-items"
            title="TYPES.Item.armor"
            createType="armor"
            isGlassy=true
            collection=inventory.armor
            equipIcon="fa-fw fa-shield"
        }}

        {{> "dhscifi.inventory-items"
            title="TYPES.Item.consumable"
            createType="consumable"
            isGlassy=true
            collection=inventory.consumables
            quantifiable=true
        }}

        {{> "dhscifi.inventory-items"
            title="TYPES.Item.loot"
            createType="loot"
            isGlassy=true
            collection=inventory.loot
            quantifiable=true
        }}
    </div>
</section>
