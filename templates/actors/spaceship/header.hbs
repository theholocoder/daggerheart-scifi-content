<header class="character-header-sheet spaceship-header-sheet">
    <div class="spaceship-sheet-body">
        <div class="spaceship-sidebar">
            <div class="portrait">
                <img src="{{document.img}}" alt="{{document.name}}" data-action="editImage" data-edit="img">
            </div>

            <div class="info-section">
                <div class="resources-section">
                    <div class="slot-value">
                        <div class="slot-bar">
                            {{#each (dhscifiResourceBoxes document.system.resources.hitPoints.value document.system.resources.hitPoints.max) as |box|}}
                                <span
                                    class="slot {{#if box.filled}}filled{{/if}}"
                                    data-action="toggleHitPoints"
                                    data-resource="hitPoints"
                                    data-value="{{box.index}}"
                                ></span>
                            {{/each}}
                        </div>
                        <div class="slot-label">
                            <span class="label">{{localize "DHSCIFI.Spaceship.HitPoints"}}</span>
                            <span class="value">
                                {{document.system.resources.hitPoints.value}} /
                                <input type="number" name="system.resources.hitPoints.max" value="{{document.system.resources.hitPoints.max}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
                            </span>
                        </div>
                    </div>

                    <div class="slot-value">
                        <div class="slot-bar">
                            {{#each (dhscifiResourceBoxes document.system.resources.stress.value document.system.resources.stress.max) as |box|}}
                                <span
                                    class="slot {{#if box.filled}}filled{{/if}}"
                                    data-action="toggleStress"
                                    data-resource="stress"
                                    data-value="{{box.index}}"
                                ></span>
                            {{/each}}
                        </div>
                        <div class="slot-label">
                            <span class="label">{{localize "DHSCIFI.Spaceship.Stress"}}</span>
                            <span class="value">
                                {{document.system.resources.stress.value}} /
                                <input type="number" name="system.resources.stress.max" value="{{document.system.resources.stress.max}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="status-section">
                    <div class="status-number evasion-stat">
                        <div class="status-value">
                            <input type="number" name="system.evasion" value="{{document.system.evasion}}" step="1" {{#unless editable}}disabled{{/unless}}>
                        </div>
                        <div class="status-label">
                            <h4>{{localize "DHSCIFI.Spaceship.Evasion"}}</h4>
                        </div>
                    </div>
                    <div class="status-number proficiency-stat">
                        <div class="status-value">
                            <input type="number" name="system.proficiency" value="{{document.system.proficiency}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}>
                        </div>
                        <div class="status-label">
                            <h4>{{localize "DHSCIFI.Spaceship.Proficiency"}}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="spaceship-main">
            <div class="name-row">
                <input
                    type="text"
                    name="name"
                    class="actor-name"
                    value="{{document.name}}"
                    placeholder="{{localize 'DHSCIFI.Spaceship.NamePlaceholder'}}"
                    autocomplete="off"
                    {{#unless editable}}disabled{{/unless}}
                >
                <div class="level-div">
                    <h3 class="label">
                        {{localize "DHSCIFI.Spaceship.Level"}}
                        <input
                            type="number"
                            name="system.level"
                            class="level-value"
                            value="{{document.system.level}}"
                            min="1"
                            step="1"
                            {{#unless editable}}disabled{{/unless}}
                        >
                    </h3>
                </div>
            </div>

            <div class="character-row">
                <div class="resource-section">
                    <div class="hope-section">
                        <h4>{{localize "DHSCIFI.Spaceship.Hope"}}</h4>
                        {{#each (dhscifiResourceBoxes document.system.resources.hope.value document.system.resources.hope.max) as |box|}}
                            <span
                                class="hope-value"
                                data-action="toggleHope"
                                data-resource="hope"
                                data-value="{{box.index}}"
                            >
                                {{#if box.filled}}
                                    <i class="fa-solid fa-diamond"></i>
                                {{else}}
                                    <i class="fa-regular fa-circle"></i>
                                {{/if}}
                            </span>
                        {{/each}}
                        <label class="hope-max">
                            <span>{{localize "DHSCIFI.Spaceship.Max"}}</span>
                            <input type="number" name="system.resources.hope.max" value="{{document.system.resources.hope.max}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
                        </label>
                    </div>
                </div>
            </div>

            <div class="character-traits">
                {{#each document.system.traits as |trait key|}}
                    <div class="trait">
                        <div class="trait-name">
                            <div
                                class="tier-mark {{#if trait.tierMarked}}marked{{/if}}"
                                data-action="toggleTraitTier"
                                data-trait="{{key}}"
                                data-tooltip="{{localize 'DHSCIFI.Spaceship.TierMarked'}}"
                            ></div>
                            <span>{{localize (concat "DHSCIFI.Spaceship.Traits." key)}}</span>
                        </div>
                        <div class="trait-value-area">
                            <svg width="52" height="46" viewBox="0 0 52 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M 0,0 H 52 L 51.0714,18.254 48.781,24.0952 47.5745,39.9596 26,46 4.42553,39.9596 3.219,24.0952 0.928571,18.254 Z" fill="var(--color-border)"/>
                                <path d="M 3.312,5.357 8.58596,0 H 43.414 l 5.274,5.357 -1.8797,28.846 c -0.2431,2.605 -2.1461,4.7522 -4.7031,5.3064 l -14.8343,3.2151 c -0.8375,0.1816 -1.7043,0.1816 -2.5418,0 L 9.89482,39.5094 C 7.33785,38.9552 5.43478,36.808 5.19169,34.203 Z" fill="var(--background)"/>
                            </svg>
                            <div class="trait-value">
                                <input
                                    type="number"
                                    name="system.traits.{{key}}.value"
                                    value="{{trait.value}}"
                                    step="1"
                                    {{#unless ../editable}}disabled{{/unless}}
                                >
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</header>
