{{!--
    Shared stub body for the sheet's not-yet-built tabs (Effects). Each of tickets
    #9-#12 replaces its tab's use of this template with a real one. `tab` is injected per-part
    by SpaceshipActorSheet._preparePartContext from the sheet's TABS config.
--}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="dhscifi-placeholder-body">
        <i class="fa-solid fa-person-digging"></i>
        <h3>{{localize tab.label}}</h3>
        <p>{{localize "DHSCIFI.Spaceship.ComingSoon"}}</p>
    </div>
</section>
