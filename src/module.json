{
  "id": "daggerheart-scifi-content",
  "title": "Daggerheart Sci-Fi Content",
  "version": "14.0.0-alpha.4",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "requires": [
      {
        "id": "daggerheart",
        "type": "system",
        "manifest": "https://github.com/Foundryborne/daggerheart/releases/latest/download/system.json"
      },
      {
        "id": "lib-wrapper",
        "type": "module",
        "manifest": "https://github.com/ruipin/fvtt-lib-wrapper/releases/latest/download/module.json"
      }
    ]
  },
  "documentTypes": {
    "Actor": {
      "spaceship": {}
    },
    "Item": {
      "system": {}
    }
  },
  "flags": {
    "canUpload": true,
    "hotReload": {
      "extensions": [
        "css",
        "html",
        "hbs",
        "json",
        "webp",
        "png",
        "jpg",
        "jpeg",
        "svg"
      ],
      "paths": ["artwork", "packs", "templates"]
    }
  },
  "authors": [
    {
      "name": "TheHolocoder",
      "url": "https://github.com/theholocoder",
      "flags": {}
    }
  ],
  "description": "This module contains Sci-Fi content for Daggerheart",
  "esmodules": ["daggerheart-scifi-content.js"],
  "styles": ["styles/daggerheart-scifi-content.css"],
  "url": "https://github.com/theholocoder/daggerheart-scifi-content",
  "manifest": "https://raw.githubusercontent.com/theholocoder/daggerheart-scifi-content/main/module.json",
  "download": "https://github.com/theholocoder/daggerheart-scifi-content/releases/latest/download/module.zip",
  "media": [
    {
      "type": "setup",
      "caption": "Daggerheart Sci-Fi Content",
      "thumbnail": "modules/daggerheart-scifi-content/artwork/module-cover.webp",
      "loop": false,
      "flags": {}
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "packs": [
    {
      "name": "character-options",
      "label": "Character Options",
      "path": "packs/character-options",
      "type": "Item",
      "system": "daggerheart",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "items",
      "label": "Items",
      "path": "packs/items",
      "type": "Item",
      "system": "daggerheart",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "adversaries",
