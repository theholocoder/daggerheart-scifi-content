      "img": "modules/daggerheart-scifi-content/artwork/icons/abilities/red-crosshairs.webp",
      "system": {
        "attribution": {},
        "description": "<p>A character may make a Finesse Action Roll against a target’s difficulty to use the vehicle’s systems to apply the <em>Lock On</em> condition.</p><p>When a character makes an <strong>Action Roll</strong> against a target that has <em>Lock On</em>, they may burn the Lock On to gain an edge, adding a <strong>d6</strong> to their attack and damage roll. This removes the <em>Lock On</em> from the target.</p>",
        "gmNotes": "",
